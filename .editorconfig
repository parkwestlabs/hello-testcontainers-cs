root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

# --- 1. 不要なコードの排除 ---
dotnet_diagnostic.IDE0005.severity = warning  # 不要な using
dotnet_diagnostic.IDE0051.severity = warning  # 未使用の private メンバー
dotnet_diagnostic.IDE0052.severity = warning  # 読み取られない private メンバー
dotnet_diagnostic.IDE0055.severity = warning  # フォーマット（インデントやスペース）違反
dotnet_diagnostic.IDE0060.severity = warning  # 未使用のパラメーター

# 未使用の式（戻り値の受け取り忘れ）を警告にする (IDE0058)
csharp_style_unused_value_expression_statement_preference = discard_variable:warning
# 未使用の変数代入（使われない上書きなど）を警告にする (IDE0059)
csharp_style_unused_value_assignment_preference = discard_variable:warning

# --- 2. バグ防止・安全性 ---
csharp_prefer_braces = true:warning           # 中括弧 {} を必須化 (IDE0011)
dotnet_style_readonly_field = true:warning    # readonly の強制 (IDE0044)
csharp_using_directive_placement = outside_namespace:warning # using は namespace の外 (IDE0065)

# --- 3. モダン C#・可読性 ---
csharp_style_namespace_declarations = file_scoped:warning # ファイルスコープ名前空間 (IDE0161)
dotnet_style_require_accessibility_modifiers = always:warning # アクセス修飾子の明示 (IDE0040)
dotnet_sort_system_directives_first = true # using の並べ替え（System 名前空間を最上部にまとめる）

# ==========================================
# var の使用ルール (IDE0007)
# ==========================================
# 1. int や string などの組み込み型で var を使う
csharp_style_var_for_built_in_types = true:warning
# 2. 右辺から型が明らかな場合（new やキャストなど）に var を使う
csharp_style_var_when_type_is_apparent = true:warning
# 3. 上記以外のメソッド戻り値などでも var を使う（※明示的な型にしたい場合は false に変更）
csharp_style_var_elsewhere = true:warning

# 左辺や引数から型が明らかな場合、new 型名() ではなく new() を使う (IDE0090)
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning

# 配列、List<T>、空コレクションなどの初期化で [] を使う (IDE0028 / IDE0300 / IDE0301 等)
csharp_style_prefer_collection_expression = true:warning
